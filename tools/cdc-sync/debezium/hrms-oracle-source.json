{
  "name": "hrms-oracle-source",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "${file:/opt/kafka/secrets/oracle.properties:host}",
    "database.port": "1521",
    "database.user": "${file:/opt/kafka/secrets/oracle.properties:user}",
    "database.password": "${file:/opt/kafka/secrets/oracle.properties:password}",
    "database.dbname": "HRMSCDB",
    "database.pdb.name": "HRMSPDB",
    "database.connection.adapter": "logminer",
    "log.mining.strategy": "online_catalog",
    "topic.prefix": "hrms",
    "schema.include.list": "HRMS",
    "table.include.list": "HRMS.DEPARTMENTS,HRMS.JOB_TITLES,HRMS.JOB_GRADES,HRMS.LOCATIONS,HRMS.HOLIDAYS,HRMS.LEAVE_TYPES,HRMS.PAY_ELEMENTS,HRMS.TAX_BRACKETS,HRMS.SYSTEM_PARAMETERS,HRMS.LOOKUP_VALUES",
    "snapshot.mode": "no_data",
    "decimal.handling.mode": "precise",
    "time.precision.mode": "connect",
    "tombstones.on.delete": "false",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "hrms.schema-history",
    "transforms": "unwrap,lowercase",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.lowercase.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.lowercase.regex": "hrms\\.HRMS\\.(.*)",
    "transforms.lowercase.replacement": "hrms.$1"
  }
}
