{
  "name": "hrms-postgres-sink",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics.regex": "hrms\\.(.*)",
    "connection.url": "jdbc:postgresql://postgres:5432/hrms",
    "connection.username": "${file:/opt/kafka/secrets/pg.properties:user}",
    "connection.password": "${file:/opt/kafka/secrets/pg.properties:password}",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "schema.evolution": "none",
    "quote.identifiers": "false",
    "table.name.format": "${topic}",
    "transforms": "route,lower",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "hrms\\.(.*)",
    "transforms.route.replacement": "$1",
    "transforms.lower.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.lower.regex": "(.*)",
    "transforms.lower.replacement": "$1"
  }
}
